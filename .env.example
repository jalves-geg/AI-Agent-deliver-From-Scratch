# Copy this file to .env.local (gitignored) and restart the dev server.
# PowerShell: copy .env.example .env.local

# xAI is the default. The API is OpenAI-compatible.
# Model must support tool calling. grok-4.7 does.
LLM_PROVIDER=xai
LLM_MODEL=grok-4.7
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=

# Also accepted for the matching provider, if LLM_API_KEY is empty:
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=

# With no key, the app runs in demo mode: a scripted assistant calls the
# same parse / list / compare tools. Set this to force demo mode even when
# a key is present. The "Run demo" button always uses the script.
# GEG_DEMO_MODE=true

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=

# --- Azure OpenAI ---
# LLM_PROVIDER=azure
# LLM_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
# AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_MODEL is ignored for Azure; the deployment name is the model.

# --- Any OpenAI-compatible server, including a local model (Ollama) ---
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
